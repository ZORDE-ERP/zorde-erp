{
  "name": "zorde-repo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=zorde-erp",
    "dev:labs": "npm run dev --prefix apps/app/zorde-labs",
    "ng:labs": "npm run ng --prefix apps/app/zorde-labs --",
    "lint": "biome check . --write",
    "lint:check": "biome check .",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "validate": "turbo run lint:check check-types test build",
    "validate:api": "npm run prisma:generate -w zorde-erp && turbo run lint:check check-types test:cov build --filter=zorde-erp"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/jest": "^30.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/api/*",
    "packages/**"
  ]
}
