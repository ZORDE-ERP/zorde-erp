{
	"info": {
		"_postman_id": "a1b2c3d4-ordem-servico-zorde",
		"name": "Zorde ERP - Ordens de Serviço",
		"description": "Collection para testar o módulo de Ordem de Serviço.\n\n**Ordem sugerida:**\n1. Auth > Login\n2. Ordens de Serviço > Criar (mínimo)\n3. Listar\n4. Buscar por ID\n5. Atualizar\n6. Deletar\n\nAjuste as variáveis `clienteId` e `tabelaMontagemId` com IDs reais do seu banco.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/v1"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "email",
			"value": "seu-email@exemplo.com"
		},
		{
			"key": "senha",
			"value": "sua-senha"
		},
		{
			"key": "clienteId",
			"value": "1"
		},
		{
			"key": "tabelaMontagemId",
			"value": "1"
		},
		{
			"key": "ordemId",
			"value": "1"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    pm.collectionVariables.set('accessToken', json.accessToken);",
									"    pm.test('Token salvo', () => pm.expect(json.accessToken).to.be.a('string'));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Autentica e salva o accessToken automaticamente na variável da collection."
					},
					"response": []
				}
			]
		},
		{
			"name": "Ordens de Serviço",
			"item": [
				{
					"name": "Criar - mínimo (obrigatórios)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    if (json && json.id) {",
									"        pm.collectionVariables.set('ordemId', json.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigoOs\": \"OS-2026-001\",\n  \"clienteId\": {{clienteId}}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/ordens-de-servico",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ordens-de-servico"]
						},
						"description": "Cria ordem apenas com campos obrigatórios: codigoOs e clienteId."
					},
					"response": []
				},
				{
					"name": "Criar - com valor",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    if (json && json.id) {",
									"        pm.collectionVariables.set('ordemId', json.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigoOs\": \"OS-2026-002\",\n  \"clienteId\": {{clienteId}},\n  \"valor\": \"1500.50\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/ordens-de-servico",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ordens-de-servico"]
						},
						"description": "Cria ordem com valor opcional (string no create)."
					},
					"response": []
				},
				{
					"name": "Criar - completo (com tabelaMontagem)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    if (json && json.id) {",
									"        pm.collectionVariables.set('ordemId', json.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigoOs\": \"OS-2026-003\",\n  \"clienteId\": {{clienteId}},\n  \"valor\": \"2500.00\",\n  \"tabelaMontagemId\": {{tabelaMontagemId}}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/ordens-de-servico",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ordens-de-servico"]
						},
						"description": "Cria ordem com todos os campos opcionais preenchidos."
					},
					"response": []
				},
				{
					"name": "Listar",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/ordens-de-servico",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ordens-de-servico"]
						},
						"description": "Lista todas as ordens do usuário autenticado (exclui soft deleted)."
					},
					"response": []
				},
				{
					"name": "Buscar por ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/ordens-de-servico/{{ordemId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ordens-de-servico", "{{ordemId}}"]
						},
						"description": "Busca uma ordem pelo ID. Usa a variável ordemId (preenchida automaticamente ao criar)."
					},
					"response": []
				},
				{
					"name": "Atualizar - básico",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": {{ordemId}},\n  \"codigoOs\": \"OS-2026-001-REV\",\n  \"clienteId\": {{clienteId}},\n  \"valor\": 1800.75\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/ordens-de-servico",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ordens-de-servico"]
						},
						"description": "Atualiza ordem. No PUT, valor é number (obrigatório e positivo)."
					},
					"response": []
				},
				{
					"name": "Atualizar - completo (com tabelaMontagem)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": {{ordemId}},\n  \"codigoOs\": \"OS-2026-001-REV\",\n  \"clienteId\": {{clienteId}},\n  \"valor\": 1800.75,\n  \"tabelaMontagemId\": {{tabelaMontagemId}}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/ordens-de-servico",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ordens-de-servico"]
						},
						"description": "Atualiza ordem incluindo tabelaMontagemId."
					},
					"response": []
				},
				{
					"name": "Deletar",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/ordens-de-servico/{{ordemId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "ordens-de-servico", "{{ordemId}}"]
						},
						"description": "Soft delete da ordem. Resposta esperada: 204 No Content."
					},
					"response": []
				}
			]
		}
	]
}
