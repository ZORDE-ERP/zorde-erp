datasource db {
  provider = "postgresql"
  schemas = ["entidades", "enderecos", "autenticacao", "financeiro"]
}

generator client {
  provider = "prisma-client-js"
}

enum TipoUsuario {
  ADMIN
  USUARIO
  @@schema("entidades")
}

model Usuario {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  senha        String
  nome         String
  documento    String      @unique
  contato      String
  ativo        Boolean     @default(true)
  ultimoAcesso DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime?   @updatedAt
  deletedAt    DateTime?
  tipoUsuario  TipoUsuario @default(ADMIN)

  Autenticacoes Autenticacao[]
  Clientes      Cliente[]
  Fornecedores  Fornecedor[]
  Ordens        OrdemDeServico[]
  @@unique([email, documento, ativo], name: "uni_usuario_email_documento_ativo")
  @@schema("entidades")
}

model Autenticacao {
  id           Int       @id @default(autoincrement())
  idUsuario    Int
  refreshToken String?    @unique
  jti          String?
  ip           String?
  dispositivo  String?
  navegador    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([idUsuario])
  @@index([jti])
  @@index([idUsuario, createdAt])
  @@schema("autenticacao")
}

model Cliente {
  id         Int       @id @default(autoincrement())
  nome       String
  email      String
  contato    String?
  tipoPessoa String
  documento  String
  status     String    @default("ATIVO")
  cep String?
  razaoSocial String?
  nomeFantasia String?
  observacao String?
  numeroEndereco String?
  usuarioId  Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  deletedAt  DateTime?

  Usuario         Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  TabelasMontagem TabelaMontagem[]
  Ordens          OrdemDeServico[]
  Endereco        Endereco?         @relation(fields: [cep], references: [cep], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId])
  @@index([documento])
  @@index([email])
  @@index([usuarioId, status])
  @@index([usuarioId, deletedAt])
  @@unique([usuarioId, documento], name: "uni_cliente_usuario_documento")
  @@unique([usuarioId, email], name: "uni_cliente_usuario_email")
  @@schema("entidades")
}

model Fornecedor {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  nome       String
  email      String
  contato    String?
  tipoPessoa String
  documento  String
  status     String    @default("ATIVO")
  cep String?
  observacao String?
  razaoSocial String?
  nomeFantasia String?
  numeroEndereco String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  deletedAt  DateTime?

  Usuario Usuario @relation(fields: [usuarioId], references: [id])
  Endereco Endereco? @relation(fields: [cep], references: [cep])

  @@index([usuarioId])
  @@index([documento])
  @@index([email])
  @@index([usuarioId, status])
  @@index([usuarioId, deletedAt])
  @@unique([usuarioId, documento], name: "uni_fornecedor_usuario_documento")
  @@unique([usuarioId, email], name: "uni_fornecedor_usuario_email")
  @@schema("entidades")
}

model TabelaMontagem {
  id        Int       @id @default(autoincrement())
  clienteId Int
  servico   String
  valor     Float
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  Cliente Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  Ordens  OrdemDeServico[]

  @@index([clienteId])
  @@index([clienteId, deletedAt])
  @@unique([clienteId, servico], name: "uni_tabela_montagem_cliente_servico")
  @@schema("entidades")
}

model OrdemDeServico {
  id               Int       @id @default(autoincrement())
  codigoOS         String
  clienteId        Int
  valor            Float?
  tabelaMontagemId Int?
  usuarioId        Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime? @updatedAt
  deletedAt        DateTime?

  Cliente        Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  TabelaMontagem TabelaMontagem? @relation(fields: [tabelaMontagemId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  Usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId, clienteId])
  @@index([usuarioId])
  @@index([tabelaMontagemId])
  @@index([codigoOS])
  @@index([clienteId, deletedAt])
  @@index([usuarioId, createdAt])
  @@unique([usuarioId, codigoOS, clienteId], name: "uni_ordem_de_servico_usuario_codigo_os_cliente_id")
  @@schema("entidades")
}

model SolicitacaoCadastro {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  codigo    String   @db.VarChar(6)
  expiracao DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiracao])
  @@schema("autenticacao")
}

model Endereco {
  id        Int       @id @default(autoincrement())
  cep       String? @unique
  uf        String?
  cidade    String?
  logradouro String?
  bairro    String?
  ibge      String?
  complemento String?
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  
  Cliente Cliente[]
  Fornecedor Fornecedor[]

  @@index([uf, cidade])
  @@index([ibge])
  @@schema("enderecos")
}

